EXPORT_PLATFORM=
# 导入目标：支持逗号分隔的多个平台，例如 imxingzhe,intervalsicu（即同时双写）
IMPORT_PLATFORM=
IGPSPORT_USERNAME=
IGPSPORT_PASSWORD=
IMXINGZHE_USERNAME=
IMXINGZHE_PASSWORD=
ONELAP_USERNAME=
ONELAP_PASSWORD=
DEBUG_MODE=False
RUN_FOREVER=False
# 行者→iGPSPORT 默认 gpx；其他方向默认 fit
SYNC_FILE_FORMAT=
# 只读检查，不上传、不写入同步游标
CHECK_ONLY=False
# 行者→iGPSPORT 上传前必须明确设为 YES
SYNC_CONFIRM=
DEDUP_TOLERANCE_KM=2.0

# ===== intervals.icu（导入端）=====
# 个人 API key：intervals.icu → Settings → 页面底部 Developer Settings
# 鉴权为 Basic，用户名固定 API_KEY，密码即此 key；不要提交真实值
INTERVALS_ICU_API_KEY=
# athlete id 留空/填 0 表示使用 API key 所属运动员；早期账号可填带 i 前缀的 id
INTERVALS_ICU_ATHLETE_ID=
# 读取多少天内的活动用于去重（默认 90）
INTERVALS_ICU_LOOKBACK_DAYS=90

# 骑行分析报告的模型点评：留空则用 agent 默认模型
RIDE_REPORT_MODEL=

# 行者网页请求中的 Bearer token；必要时填写 Cookie（不要提交真实值）
IMXINGZHE_TOKEN=
IMXINGZHE_COOKIE=

# 瞬时网络故障重试（登录/同步被对端掐断时自动重试，减少误告警）
LOGIN_ATTEMPTS=3
LOGIN_BACKOFF=3
SYNC_ATTEMPTS=3
SYNC_BACKOFF=5
